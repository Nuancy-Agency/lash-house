---
import { SITE, bookingLink } from "../data/site";
import { t } from "../data/i18n";

const links = [
  { href: "#sobre", i18n: "nav.sobre" },
  { href: "#servicos", i18n: "nav.servicos" },
  { href: "#resultados", i18n: "nav.resultados" },
  { href: "#depoimentos", i18n: "nav.depoimentos" },
  { href: "#localizacao", i18n: "nav.localizacao" },
] as const;
---

<header
  x-data="{ open: false }"
  x-on:keydown.escape.window="if (open) { open = false; $refs.menuToggle.focus(); }"
  class="sticky top-0 z-40 border-b border-ink/10 bg-paper/90 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="#hero" class="inline-flex min-h-11 items-center font-display text-xl tracking-tight text-ink" translate="no">
      {SITE.nome}
    </a>

    <nav class="hidden gap-8 md:flex" aria-label="Navegação principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-i18n={link.i18n}
            class="text-sm font-medium text-ink/80 transition-colors hover:text-ink focus-visible:text-ink"
          >
            {t.pt[link.i18n]}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <button
        type="button"
        onclick="window.lashHouseToggleLang && window.lashHouseToggleLang()"
        data-lang-toggle-aria
        aria-label={t.pt["lang.toggleLabel"]}
        title={t.pt["lang.toggleLabel"]}
        class="inline-flex min-h-11 items-center rounded-full border border-ink/20 px-3 text-xs font-semibold tracking-wide text-ink/80 uppercase transition-colors hover:border-ink/40 hover:text-ink"
      >
        <span data-lang-current>PT</span>
      </button>
      <a
        href={bookingLink("pt")}
        data-href-pt={bookingLink("pt")}
        data-href-en={bookingLink("en")}
        data-i18n="nav.cta"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-transform hover:scale-[1.02] focus-visible:scale-[1.02]"
      >
        {t.pt["nav.cta"]}
      </a>
    </div>

    <button
      type="button"
      x-ref="menuToggle"
      x-on:click="open = !open"
      data-js-toggle
      :aria-expanded="open"
      aria-controls="menu-mobile"
      class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-ink md:hidden"
    >
      <span class="sr-only" x-text="open ? 'Fechar menu' : 'Abrir menu'">Abrir menu</span>
      <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg x-show="open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true" x-cloak>
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="menu-mobile"
    x-show="open"
    x-cloak
    x-transition
    aria-label="Navegação mobile"
    class="border-t border-ink/10 bg-paper md:hidden"
  >
    <ul class="flex flex-col px-4 py-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.i18n}
              x-on:click="open = false"
              class="block min-h-11 py-3 text-base font-medium text-ink/80 hover:text-ink"
            >
              {t.pt[link.i18n]}
            </a>
          </li>
        ))
      }
      <li class="flex items-center justify-between gap-3 py-3">
        <button
          type="button"
          onclick="window.lashHouseToggleLang && window.lashHouseToggleLang()"
          data-lang-toggle-aria
          aria-label={t.pt["lang.toggleLabel"]}
          title={t.pt["lang.toggleLabel"]}
          class="inline-flex min-h-11 items-center rounded-full border border-ink/20 px-4 text-xs font-semibold tracking-wide text-ink/80 uppercase"
        >
          <span data-lang-current>PT</span>
        </button>
        <a
          href={bookingLink("pt")}
          data-href-pt={bookingLink("pt")}
          data-href-en={bookingLink("en")}
          data-i18n="nav.cta"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 flex-1 items-center justify-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper"
        >
          {t.pt["nav.cta"]}
        </a>
      </li>
    </ul>
  </nav>
</header>
