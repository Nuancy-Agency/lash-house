---
import { SITE, bookingLink } from "../data/site";
import { t } from "../data/i18n";
---

<section id="localizacao" class="scroll-mt-20 bg-cream/60 py-20">
  <div class="reveal mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-2 md:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-umber" data-i18n="localizacao.eyebrow">
        {t.pt["localizacao.eyebrow"]}
      </p>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl" style="text-wrap: balance;" data-i18n="localizacao.heading">
        {t.pt["localizacao.heading"]}
      </h2>
      <p class="mt-4 max-w-prose text-ink/75">{SITE.endereco}</p>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={SITE.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold text-ink hover:bg-ink/5"
        >
          <span data-i18n="localizacao.ctaMaps">{t.pt["localizacao.ctaMaps"]}</span>
        </a>
        <a
          href={bookingLink("pt")}
          data-href-pt={bookingLink("pt")}
          data-href-en={bookingLink("en")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-transform hover:scale-[1.02]"
        >
          <span data-i18n="localizacao.ctaBooking">{t.pt["localizacao.ctaBooking"]}</span>
        </a>
      </div>
    </div>

    <div class="overflow-hidden rounded-3xl border border-ink/10 shadow-sm">
      <iframe
        title={`Mapa — ${SITE.nome}, ${SITE.endereco}`}
        src={`https://www.google.com/maps?q=${encodeURIComponent(SITE.endereco)}&output=embed`}
        class="h-80 w-full"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
