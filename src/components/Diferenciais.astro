---
import { t } from "../data/i18n";

const diferenciais = [0, 1] as const;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="diferenciais-heading">
  <h2 id="diferenciais-heading" class="sr-only">
    Diferenciais
  </h2>
  <ul class="reveal grid gap-6 sm:grid-cols-2">
    {
      diferenciais.map((i) => (
        <li class="rounded-2xl border border-gold/40 bg-gradient-to-br from-cream to-paper p-8">
          <h3 class="font-display text-2xl text-ink" data-i18n={`diferencial.${i}.titulo`}>
            {t.pt[`diferencial.${i}.titulo`]}
          </h3>
          <p class="mt-3 text-ink/70" data-i18n={`diferencial.${i}.texto`}>
            {t.pt[`diferencial.${i}.texto`]}
          </p>
        </li>
      ))
    }
  </ul>
</section>
