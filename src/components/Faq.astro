---
// Mini-FAQ adicionada em 2026-09-12 (achado P1 do /impeccable critique:
// zero preço/reasseguramento pré-visita em toda a página, no momento de
// maior risco de decisão). Respostas usam só informação já verdadeira em
// outras seções (preço confirmado no Fresha, clientela de +30 países,
// Instagram como canal real) — nada inventado sobre dor, duração exata ou
// política de cancelamento não confirmadas pela cliente.
import { t } from "../data/i18n";

const perguntas = [0, 1, 2, 3] as const;
---

<section id="faq" class="scroll-mt-20 mx-auto max-w-3xl px-4 py-20 sm:px-6">
  <div class="reveal">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-umber" data-i18n="faq.eyebrow">
      {t.pt["faq.eyebrow"]}
    </p>
    <h2 class="mt-3 font-display text-3xl sm:text-4xl" style="text-wrap: balance;" data-i18n="faq.heading">
      {t.pt["faq.heading"]}
    </h2>

    <div class="mt-8 divide-y divide-ink/10 border-t border-b border-ink/10">
      {
        perguntas.map((i) => (
          <details class="group">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-5 text-base font-semibold text-ink marker:content-none">
              <span data-i18n={`faq.q${i}`}>{t.pt[`faq.q${i}`]}</span>
              <span
                aria-hidden="true"
                class="shrink-0 text-xl leading-none text-umber transition-transform duration-200 group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 pb-5 text-sm leading-relaxed text-ink/70 sm:text-base" data-i18n={`faq.a${i}`}>
              {t.pt[`faq.a${i}`]}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
